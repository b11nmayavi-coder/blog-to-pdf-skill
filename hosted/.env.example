# Copy to ~/.local/share/blog-pdf/.env (chmod 600) and fill in.
# Claude API key (console.anthropic.com) — writes the reader's-companion page
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Optional backup summariser (ollama.com cloud), tried in order if Claude fails
OLLAMA_API_KEY=
MODELS=gpt-oss:120b,gpt-oss:20b
PORT=8099
# rclone destination; leave empty to keep PDFs local only
DRIVE_DIR="gdrive:Blog PDFs"
